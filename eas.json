{
  "cli": {
    "version": ">= 16.1.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRealDebug"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "APP_VARIANT": "test"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assemblePreviewRelease"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRealRelease"
      },
      "developmentClient": false,
      "distribution": "store"
    }
  },
  "submit": {
    "production": {}
  }
}
